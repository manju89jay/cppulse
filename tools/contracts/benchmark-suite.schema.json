{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cppulse.local/schemas/development/benchmark-suite-1.0.0.json",
  "title": "Explicit local benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "cases"],
  "properties": {
    "version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "description": {"type": "string", "maxLength": 4096},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "cwd", "repetitions", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
          "argv": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {"type": "string", "minLength": 1, "maxLength": 32768}
          },
          "cwd": {"type": "string", "minLength": 1, "maxLength": 32768},
          "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
          "expected_exit": {"type": "integer", "minimum": 0, "maximum": 255},
          "description": {"type": "string", "maxLength": 4096}
        }
      }
    }
  }
}
