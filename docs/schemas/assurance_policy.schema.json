{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cppulse configurable assurance policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "policy_version", "standards", "scope", "gates", "controls"],
  "properties": {
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "standards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "edition"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "edition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_readiness", "minimum_completeness"],
      "properties": {
        "minimum_readiness": { "type": "number", "minimum": 0, "maximum": 100 },
        "minimum_completeness": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "controls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "kind", "weight", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["findings", "evidence"] },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "required": { "type": "boolean" },
          "references": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "applicable_to": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["application", "library", "header-only"] }
          },
          "rule_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "max_findings": { "type": "integer", "minimum": 0 },
          "evidence_id": { "type": "string", "minLength": 1 },
          "contexts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "findings" } } },
            "then": {
              "required": ["rule_ids", "max_findings"],
              "not": { "anyOf": [{ "required": ["evidence_id"] }, { "required": ["contexts"] }] }
            },
            "else": {
              "required": ["evidence_id"],
              "not": { "anyOf": [{ "required": ["rule_ids"] }, { "required": ["max_findings"] }] }
            }
          }
        ]
      }
    }
  }
}
