{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cppulse evidence manifest",
  "type": "object", "additionalProperties": false,
  "required": ["version", "subject", "records"],
  "definitions": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "properties": {
    "version": { "const": "1.0.0" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "tree_digest", "kind"],
      "properties": {
        "revision": { "type": ["string", "null"], "minLength": 1 },
        "tree_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["application", "library", "header-only"] }
      }
    },
    "analysis": { "$ref": "#/definitions/artifact" },
    "analysis_inputs": {
      "type": "array", "items": { "$ref": "#/definitions/artifact" }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "tool", "origin", "artifacts", "contexts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "tool": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["attestation", "execution"] },
          "artifacts": {
            "type": "array", "minItems": 1,
            "items": { "$ref": "#/definitions/artifact" }
          },
          "contexts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
