{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cppulse assurance assessment (not a safety certification)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "generated_at", "subject", "policy", "gate", "scores", "controls", "limitations"],
  "properties": {
    "version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "tree_digest", "kind", "files"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "tree_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["application", "library", "header-only"] },
        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "policy_version", "sha256", "standards"],
      "properties": {
        "id": { "type": "string" },
        "policy_version": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "standards": { "type": "array", "items": { "type": "object", "required": ["name", "edition"], "properties": { "name": { "type": "string" }, "edition": { "type": "string" } }, "additionalProperties": false } }
      }
    },
    "gate": { "enum": ["passed", "failed", "insufficient_evidence"] },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["readiness", "evidence_completeness", "observed"],
      "properties": {
        "readiness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "evidence_completeness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "observed": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "controls": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "status", "weight", "required", "reason", "evidence", "references"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["passed", "failed", "unknown", "not_applicable"] },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "references": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
