{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pinned original cppulse native/history corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "methodology", "projects"],
  "properties": {
    "version": {"const": "1.0.0"},
    "methodology": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "frozen_at", "history_depth", "selection", "context", "acceptance", "limitations"],
      "properties": {
        "id": {"const": "original-six-native-and-history-1"},
        "frozen_at": {"type": "string", "format": "date"},
        "history_depth": {"type": "integer", "minimum": 100},
        "selection": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "projects": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "repository", "tag", "revision"],
        "properties": {
          "id": {"enum": ["fmt", "grpc", "json", "leveldb", "poco", "protobuf"]},
          "repository": {"type": "string", "pattern": "^https://github\\.com/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$"},
          "tag": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  }
}
