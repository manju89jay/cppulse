{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/frozen-input/v0.1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "cache_eligible": {
      "const": false
    },
    "closure": {
      "const": "unqualified"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "directory",
              "regular",
              "symlink"
            ]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "mtime_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "source_root": {
            "type": "string",
            "maxLength": 4096
          },
          "source_relative": {
            "type": "string",
            "maxLength": 4096
          },
          "content": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "sha256",
                  "size_bytes"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "mode",
          "mtime_ns",
          "source_root",
          "source_relative",
          "content",
          "target"
        ]
      },
      "maxItems": 4096
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ]
    }
  },
  "required": [
    "version",
    "cache_eligible",
    "closure",
    "request_sha256",
    "entries",
    "layer",
    "config"
  ]
}
