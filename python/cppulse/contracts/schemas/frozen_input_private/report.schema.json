{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/frozen-input/v0.1/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "cache_eligible": {
      "const": false
    },
    "closure": {
      "const": "unqualified"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "container_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_filesystem_observed": {
      "type": "boolean"
    },
    "unresolved_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "client_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "exit_status": {
            "type": "integer",
            "minimum": -255,
            "maximum": 255
          },
          "stdout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sha256",
              "size_bytes"
            ]
          },
          "stderr": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sha256",
              "size_bytes"
            ]
          }
        },
        "required": [
          "argv",
          "exit_status",
          "stdout",
          "stderr"
        ]
      },
      "maxItems": 16
    },
    "native_receipt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invocation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "cwd": {
                  "type": "string",
                  "maxLength": 4096
                },
                "environment": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              },
              "required": [
                "argv",
                "cwd",
                "environment"
              ]
            },
            "exit_status": {
              "type": "integer",
              "minimum": -255,
              "maximum": 255
            },
            "stdout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sha256",
                "size_bytes"
              ]
            },
            "stderr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sha256",
                "size_bytes"
              ]
            }
          },
          "required": [
            "invocation",
            "exit_status",
            "stdout",
            "stderr"
          ]
        }
      ]
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ]
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ]
    }
  },
  "required": [
    "version",
    "cache_eligible",
    "closure",
    "request_sha256",
    "manifest_sha256",
    "image_id",
    "container_id",
    "frozen_filesystem_observed",
    "unresolved_inputs",
    "client_receipts",
    "native_receipt",
    "inspect",
    "diff"
  ]
}
