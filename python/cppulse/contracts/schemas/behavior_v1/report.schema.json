{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/behavior/v1/report.schema.json",
  "title": "Finite historical ownership and co-change facts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "method": {
      "const": "cppulse-git-behavior-1"
    },
    "relationship_kind": {
      "const": "historical_cochange"
    },
    "head": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "half_life_days": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 36500
        },
        "max_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_files_per_commit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_pair_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "minimum_support": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "aliases": {
          "type": "object",
          "maxProperties": 100000,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "bot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 100000
        },
        "former_contributor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 100000
        },
        "offboarding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 100000
        },
        "teams": {
          "type": "object",
          "maxProperties": 100000,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "components": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "exclude_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "exclude_commit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "uniqueItems": true,
          "maxItems": 100000
        },
        "include_merges": {
          "type": "boolean"
        },
        "pair_attribution": {
          "enum": [
            "author_only",
            "coauthor_trailers"
          ]
        }
      },
      "required": [
        "version",
        "window_days",
        "half_life_days",
        "max_commits",
        "max_files_per_commit",
        "max_pair_records",
        "minimum_support",
        "aliases",
        "bot_ids",
        "former_contributor_ids",
        "offboarding_ids",
        "teams",
        "components",
        "exclude_paths",
        "exclude_commit_ids",
        "include_merges",
        "pair_attribution"
      ]
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "history_status": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_commits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "accepted_commits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "excluded_commits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "future": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "outside_window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "explicit_exclusion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "merge": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "bulk": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "generated_only": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "no_selected_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "bot_only": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": []
        },
        "dropped_pair_updates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        }
      },
      "required": [
        "observed_commits",
        "accepted_commits",
        "excluded_commits",
        "dropped_pair_updates"
      ]
    },
    "files": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "touches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "weighted_changes": {
            "type": "number",
            "minimum": 0
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "weighted_changes": {
                  "type": "number",
                  "minimum": 0
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "team": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "former_contributor": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "weighted_changes",
                "share",
                "team",
                "former_contributor"
              ]
            },
            "maxItems": 100000
          },
          "fragmentation": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_authors": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "weighted_changes": {
                  "type": "number",
                  "minimum": 0
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "weighted_changes",
                "share"
              ]
            },
            "maxItems": 100000
          },
          "team_fragmentation": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "offboarding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "removed_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "uniqueItems": true,
                "maxItems": 100000
              },
              "removed_share": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "remaining_share": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "remaining_author_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "uniqueItems": true,
                "maxItems": 100000
              }
            },
            "required": [
              "removed_ids",
              "removed_share",
              "remaining_share",
              "remaining_author_ids"
            ]
          }
        },
        "required": [
          "file",
          "availability",
          "touches",
          "weighted_changes",
          "authors",
          "fragmentation",
          "effective_authors",
          "teams",
          "team_fragmentation",
          "offboarding"
        ]
      }
    },
    "coupling": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "support": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "left_touches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "right_touches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "jaccard": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "left_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "right_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "left",
          "right",
          "support",
          "left_touches",
          "right_touches",
          "jaccard",
          "left_confidence",
          "right_confidence"
        ]
      }
    },
    "components": {
      "type": "array",
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "uniqueItems": true,
            "maxItems": 100000
          },
          "ownership": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "touches": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "weighted_changes": {
                "type": "number",
                "minimum": 0
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "weighted_changes": {
                      "type": "number",
                      "minimum": 0
                    },
                    "share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "team": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "former_contributor": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "weighted_changes",
                    "share",
                    "team",
                    "former_contributor"
                  ]
                },
                "maxItems": 100000
              },
              "fragmentation": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_authors": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "teams": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "weighted_changes": {
                      "type": "number",
                      "minimum": 0
                    },
                    "share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "id",
                    "weighted_changes",
                    "share"
                  ]
                },
                "maxItems": 100000
              },
              "team_fragmentation": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "offboarding": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "removed_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "uniqueItems": true,
                    "maxItems": 100000
                  },
                  "removed_share": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "remaining_share": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "remaining_author_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "uniqueItems": true,
                    "maxItems": 100000
                  }
                },
                "required": [
                  "removed_ids",
                  "removed_share",
                  "remaining_share",
                  "remaining_author_ids"
                ]
              }
            },
            "required": [
              "availability",
              "touches",
              "weighted_changes",
              "authors",
              "fragmentation",
              "effective_authors",
              "teams",
              "team_fragmentation",
              "offboarding"
            ]
          }
        },
        "required": [
          "id",
          "files",
          "ownership"
        ]
      }
    },
    "component_coupling": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "support": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "left_touches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "right_touches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "jaccard": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "left_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "right_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "left",
          "right",
          "support",
          "left_touches",
          "right_touches",
          "jaccard",
          "left_confidence",
          "right_confidence"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "method",
    "relationship_kind",
    "head",
    "cutoff",
    "configuration",
    "configuration_digest",
    "input_digest",
    "history_status",
    "counts",
    "files",
    "coupling",
    "components",
    "component_coupling",
    "limitations"
  ]
}
