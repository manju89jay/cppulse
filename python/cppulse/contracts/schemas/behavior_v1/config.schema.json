{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/behavior/v1/config.schema.json",
  "title": "Explicit historical behavior configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36500
    },
    "half_life_days": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 36500
    },
    "max_commits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_files_per_commit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "max_pair_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "minimum_support": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "aliases": {
      "type": "object",
      "maxProperties": 100000,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "bot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "former_contributor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "offboarding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "teams": {
      "type": "object",
      "maxProperties": 100000,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "components": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "exclude_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "exclude_commit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "include_merges": {
      "type": "boolean"
    },
    "pair_attribution": {
      "enum": [
        "author_only",
        "coauthor_trailers"
      ]
    }
  },
  "required": [
    "version",
    "window_days",
    "half_life_days",
    "max_commits",
    "max_files_per_commit",
    "max_pair_records",
    "minimum_support",
    "aliases",
    "bot_ids",
    "former_contributor_ids",
    "offboarding_ids",
    "teams",
    "components",
    "exclude_paths",
    "exclude_commit_ids",
    "include_merges",
    "pair_attribution"
  ]
}
