{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/git-history/private/raw_commit.schema.json",
  "title": "Private checked Git history raw_commit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
      },
      "uniqueItems": true
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "committed_date": {
      "type": "integer",
      "minimum": -62135596800,
      "maximum": 253402300799
    },
    "message": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "old_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "new_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "A",
              "M",
              "D",
              "R",
              "C",
              "T",
              "U"
            ]
          },
          "insertions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deletions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "binary": {
            "type": "boolean"
          }
        },
        "required": [
          "old_path",
          "new_path",
          "status",
          "insertions",
          "deletions",
          "binary"
        ]
      }
    },
    "total_files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "available": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "commit_id",
    "parents",
    "author",
    "committed_date",
    "message",
    "changes",
    "total_files",
    "available",
    "limitations"
  ]
}
