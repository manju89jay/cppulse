{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/git-history/private/checkpoint.schema.json",
  "title": "Private checked Git history checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "version",
        "profile_digest",
        "head",
        "max_commits"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "ids_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "count",
        "ids_sha256",
        "history_truncated"
      ]
    },
    "facts_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "complete": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "request",
    "selection",
    "facts_sha256",
    "complete",
    "limitations"
  ]
}
