{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/rule_registry.schema.json",
  "title": "cppulse rule_registry v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "maturity": {
            "enum": [
              "experimental",
              "stable",
              "deprecated"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "supported_inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "configuration_schema": {
            "type": "object"
          },
          "documentation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "maturity",
          "category",
          "required_capabilities",
          "supported_inputs",
          "configuration_schema",
          "documentation"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "rules"
  ]
}
