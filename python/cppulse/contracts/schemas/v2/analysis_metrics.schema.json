{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/analysis_metrics.schema.json",
  "title": "cppulse analysis_metrics v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "context_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "metric_version": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "line",
              "column",
              "end_line",
              "end_column"
            ]
          }
        },
        "required": [
          "id",
          "file",
          "symbol",
          "context_id",
          "metric",
          "metric_version",
          "value",
          "units",
          "availability",
          "limitations"
        ]
      },
      "minItems": 0
    },
    "analysis_inventory_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "job_context_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    }
  },
  "required": [
    "version",
    "source_digest",
    "items"
  ]
}
