{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/coverage_facts.schema.json",
  "title": "cppulse source-bound coverage counts v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "origin": {
      "enum": [
        "import",
        "execution"
      ]
    },
    "producer": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "lcov",
            "cobertura"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "report_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "receipt_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_receipt_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "test_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "instrumentation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_artifact_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "mapping_artifact_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "source_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "object_artifact_id",
          "mapping_artifact_id",
          "source_files"
        ]
      },
      "minItems": 0
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "binary_artifact_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "test_receipt_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          }
        },
        "required": [
          "artifact_id",
          "binary_artifact_id",
          "test_receipt_id"
        ]
      },
      "minItems": 0
    },
    "usability": {
      "enum": [
        "usable",
        "stale",
        "mismatched",
        "unsupported",
        "malformed",
        "missing"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "line",
                    "branch",
                    "function"
                  ]
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "units": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "covered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "covered",
                      "total"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "kind",
                "method",
                "covered",
                "total",
                "units"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "file",
          "source_sha256",
          "measurements"
        ]
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "id",
    "source_digest",
    "context_id",
    "origin",
    "producer",
    "adapter",
    "report_artifact_id",
    "receipt_id",
    "proof_receipt_ids",
    "test_evidence_ids",
    "instrumentation",
    "profiles",
    "usability",
    "files",
    "limitations"
  ]
}
