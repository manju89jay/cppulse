{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/collection_plan.schema.json",
  "title": "cppulse explicit collection plan v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": "2.0.0"},
    "id": {"$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"},
    "recipe": {
      "allOf": [
        {"$ref": "https://schemas.cppulse.local/v2/recipe.schema.json"},
        {"properties": {"jobs": {"maximum": 32}}}
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"},
          "step_id": {"$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"},
          "kind": {"enum": ["build", "tests"]},
          "scope_files": {"$ref": "#/definitions/paths"},
          "report_path": {"type": ["string", "null"], "minLength": 1},
          "execution_log_path": {"type": ["string", "null"], "minLength": 1},
          "adapter": {"enum": [null, "ctest-junit"]},
          "adapter_version": {"enum": [null, "1.0.0"]},
          "inventory_step_id": {"anyOf": [{"type": "null"}, {"$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"}]},
          "producer_version_step_id": {"anyOf": [{"type": "null"}, {"$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"}]},
          "exercised_inputs": {"$ref": "#/definitions/paths"}
        },
        "required": ["id", "step_id", "kind", "scope_files", "report_path", "execution_log_path", "adapter", "adapter_version", "inventory_step_id", "producer_version_step_id", "exercised_inputs"],
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "build"}}},
            "then": {
              "properties": {
                "report_path": {"const": null},
                "execution_log_path": {"const": null},
                "adapter": {"const": null},
                "adapter_version": {"const": null},
                "inventory_step_id": {"const": null},
                "producer_version_step_id": {"const": null}
              }
            },
            "else": {
              "properties": {
                "report_path": {"type": "string", "minLength": 1},
                "execution_log_path": {"type": "string", "minLength": 1},
                "adapter": {"const": "ctest-junit"},
                "adapter_version": {"const": "1.0.0"},
                "inventory_step_id": {"type": "string"},
                "producer_version_step_id": {"type": "string"}
              }
            }
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_log_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "max_metadata_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "termination_grace_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["max_log_bytes", "max_artifact_bytes", "max_metadata_bytes", "termination_grace_seconds"]
    }
  },
  "required": ["version", "id", "recipe", "bindings", "limits"],
  "definitions": {
    "paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
