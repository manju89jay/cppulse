{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/common.schema.json",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "version"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ]
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "2.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "application",
            "library",
            "header-only"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/source_file"
          },
          "minItems": 0
        },
        "inventory_complete": {
          "type": "boolean",
          "description": "True is a caller assertion for this explicit finite selected file inventory only; it does not establish discovery completeness or observe new unlisted files."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "path_case_sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "digest",
        "kind",
        "files",
        "inventory_complete",
        "limitations"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "id",
        "sha256",
        "availability"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiler": {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "language_standard": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "enum": [
            "observed",
            "inferred",
            "fallback"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/dependency"
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "version",
        "id",
        "digest",
        "compiler",
        "argv",
        "working_directory",
        "language_standard",
        "target",
        "provenance",
        "dependencies",
        "limitations"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "timed_out",
            "cancelled",
            "skipped",
            "not_attempted"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "depends_on",
        "reason"
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "skipped",
        "errors"
      ]
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "feature",
        "importance",
        "value"
      ]
    }
  }
}
