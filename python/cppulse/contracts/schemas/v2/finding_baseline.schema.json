{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/finding_baseline.schema.json",
  "title": "cppulse source-anchored finding baseline v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "producer": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
    },
    "source_digest": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "original_run_id": {
      "type": "string",
      "minLength": 1
    },
    "original_manifest_sha256": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "original_manifest_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "observations_artifact_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint_version": {
      "const": "native-line-anchor-1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_ids": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sha256": {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
        }
      },
      "required": [
        "files",
        "context_ids",
        "rule_ids",
        "sha256"
      ]
    },
    "config_digest": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "context_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "parse_context_digest": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "inventory_id": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_artifact_id": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "registry_sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "config_sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "native_executable_sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "complete",
              "incomplete",
              "unavailable"
            ]
          },
          "executed_rules": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "file",
          "context_id",
          "parse_context_digest",
          "inventory_id",
          "source_artifact_id",
          "source_sha256",
          "registry_sha256",
          "config_sha256",
          "native_executable_sha256",
          "status",
          "executed_rules"
        ]
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "context_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "parse_context_digest": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "producer": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
          },
          "rule_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor_sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor_status": {
            "enum": [
              "unique",
              "ambiguous",
              "unavailable"
            ]
          },
          "fingerprint": {
            "anyOf": [
              {
                "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "file",
          "context_id",
          "parse_context_digest",
          "producer",
          "rule_id",
          "rule_version",
          "severity",
          "message",
          "column",
          "anchor_sha256",
          "anchor_status",
          "fingerprint",
          "count",
          "observation_ids"
        ]
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": false
    }
  },
  "required": [
    "version",
    "id",
    "producer",
    "source_digest",
    "original_run_id",
    "original_manifest_sha256",
    "original_manifest_artifact_id",
    "observations_artifact_ids",
    "created_at",
    "reason",
    "fingerprint_version",
    "scope",
    "config_digest",
    "cells",
    "findings",
    "limitations"
  ]
}
