{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/assessment_lineage.schema.json",
  "title": "cppulse bounded assessment-only lineage v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "source_digest": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "facts_base_run": {
      "$ref": "https://schemas.cppulse.local/v2/workflow_common.schema.json#/definitions/run_ref"
    },
    "selected_parent_run": {
      "$ref": "https://schemas.cppulse.local/v2/workflow_common.schema.json#/definitions/run_ref"
    },
    "base_manifest_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "parent_manifest_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "policy_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "assessment_artifact_id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "history_artifact_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "id",
    "source_digest",
    "facts_base_run",
    "selected_parent_run",
    "base_manifest_artifact_id",
    "parent_manifest_artifact_id",
    "policy_artifact_id",
    "assessment_artifact_id",
    "history_artifact_ids",
    "created_at"
  ]
}
