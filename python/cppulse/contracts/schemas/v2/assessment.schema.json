{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/assessment.schema.json",
  "title": "cppulse assessment v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "policy_version",
        "sha256"
      ]
    },
    "gate": {
      "enum": [
        "passed",
        "failed",
        "insufficient_evidence"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "number",
          "minimum": 0
        },
        "failed": {
          "type": "number",
          "minimum": 0
        },
        "unknown": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "failed",
        "unknown"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "evidence_completeness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "observed_satisfaction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "maximum_possible_readiness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "readiness",
        "evidence_completeness",
        "observed_satisfaction",
        "maximum_possible_readiness"
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unknown",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "required": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "context_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "uniqueItems": true
          },
          "incomplete": {
            "type": "boolean"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "reason",
          "weight",
          "required",
          "evidence_ids",
          "references"
        ]
      },
      "minItems": 0
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "control_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "context_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "active": {
            "type": "boolean"
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "inactive_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "control_id",
          "source_digest",
          "context_ids",
          "reason",
          "owner",
          "reviewer",
          "approved_at",
          "expires_at",
          "active"
        ]
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evaluator": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
    }
  },
  "required": [
    "version",
    "run_id",
    "source_digest",
    "policy",
    "gate",
    "generated_at",
    "weights",
    "scores",
    "controls",
    "deviations",
    "limitations"
  ]
}
