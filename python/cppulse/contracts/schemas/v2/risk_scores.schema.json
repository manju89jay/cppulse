{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/risk_scores.schema.json",
  "title": "cppulse risk_scores v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "enum": [
            "heuristic",
            "xgboost",
            "legacy_claim_unverified"
          ]
        },
        "score_kind": {
          "enum": [
            "heuristic_rank",
            "model_rank"
          ]
        },
        "experimental": {
          "const": true
        },
        "feature_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "training_samples": {
          "type": "integer",
          "minimum": 0
        },
        "label_source": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_status": {
          "enum": [
            "not_evaluated",
            "cross_validated"
          ]
        },
        "f1_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "active_features": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_feature_count": {
          "type": "integer",
          "minimum": 0
        },
        "legacy_reported_feature_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "generated_at",
        "method",
        "score_kind",
        "experimental",
        "feature_count",
        "training_samples",
        "label_source",
        "evaluation_status",
        "f1_score",
        "limitations",
        "active_features"
      ]
    },
    "health_score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "availability": {
          "enum": [
            "scored",
            "no_data",
            "partial",
            "unverified"
          ]
        },
        "scorer_version": {
          "type": "string",
          "minLength": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "overall",
        "by_category",
        "availability",
        "scorer_version",
        "denominator",
        "limitations"
      ]
    },
    "file_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk_level": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "top_factors": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/factor"
            },
            "minItems": 0
          },
          "explanation_kind": {
            "enum": [
              "shap",
              "global_gain",
              "heuristic_weights",
              "legacy_unverified"
            ]
          }
        },
        "required": [
          "file",
          "score",
          "risk_level",
          "top_factors",
          "explanation_kind"
        ]
      },
      "minItems": 0
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "finding_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "file",
          "score",
          "method",
          "finding_count"
        ]
      },
      "minItems": 0
    },
    "legacy_observed_health": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "metadata",
    "health_score",
    "file_risks",
    "hotspots"
  ]
}
