{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "analyzed-kloc-context-v3",
            "analyzed-kloc-context-v4"
          ]
        },
        "version": {
          "enum": [
            "3.0.0",
            "4.0.0"
          ]
        },
        "profile": {
          "enum": [
            "default",
            "safety-critical",
            "custom"
          ]
        },
        "loc_metric": {
          "const": "physical_loc"
        },
        "metric_version": {
          "const": "cppulse-metrics-1"
        },
        "allow_inferred_parse": {
          "type": "boolean"
        },
        "required_rule_ids": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_rule_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "memory_safety",
                  "complexity",
                  "modernization",
                  "misra"
                ]
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "density_cap": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "category",
              "weight",
              "density_cap"
            ]
          },
          "minItems": 1
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requires_buffer_coherence": {
          "const": true
        }
      },
      "required": [
        "id",
        "version",
        "profile",
        "loc_metric",
        "metric_version",
        "allow_inferred_parse",
        "required_rule_ids",
        "required_rule_versions",
        "categories",
        "configuration_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "analyzed-kloc-context-v4"
              }
            }
          },
          "then": {
            "required": [
              "requires_buffer_coherence"
            ],
            "properties": {
              "version": {
                "const": "4.0.0"
              }
            }
          },
          "else": {
            "properties": {
              "version": {
                "const": "3.0.0"
              }
            },
            "not": {
              "required": [
                "requires_buffer_coherence"
              ]
            }
          }
        }
      ]
    },
    "consumer_assurance": {
      "const": "not_assessed"
    },
    "required_context_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "uniqueItems": true
    },
    "optional_context_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
      },
      "uniqueItems": true
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_context_id": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "availability": {
            "enum": [
              "scored",
              "partial",
              "unavailable",
              "unverified",
              "no_data"
            ]
          },
          "analysis_inventory_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "uniqueItems": true
          },
          "metric_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            "uniqueItems": true
          },
          "declared_files": {
            "type": "integer",
            "minimum": 0
          },
          "analyzed_files": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_files": {
            "type": "integer",
            "minimum": 0
          },
          "physical_loc": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "code_loc": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parse_context_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "database": {
                "type": "integer",
                "minimum": 0
              },
              "inferred": {
                "type": "integer",
                "minimum": 0
              },
              "fallback": {
                "type": "integer",
                "minimum": 0
              },
              "none": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "database",
              "inferred",
              "fallback",
              "none"
            ]
          },
          "finding_counts": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "memory_safety",
                "complexity",
                "modernization",
                "misra"
              ]
            },
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "category_calculations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "enum": [
                    "memory_safety",
                    "complexity",
                    "modernization",
                    "misra"
                  ]
                },
                "count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "density": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "penalty": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "category",
                "count",
                "density",
                "penalty",
                "score"
              ]
            }
          },
          "weighted_penalty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "weight_sum": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "overall": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "job_context_id",
          "availability",
          "analysis_inventory_ids",
          "metric_ids",
          "declared_files",
          "analyzed_files",
          "excluded_files",
          "physical_loc",
          "code_loc",
          "parse_context_counts",
          "finding_counts",
          "category_calculations",
          "weighted_penalty",
          "weight_sum",
          "overall",
          "limitations"
        ]
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "scored",
            "partial",
            "no_data"
          ]
        },
        "overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "by_category": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "memory_safety",
              "complexity",
              "modernization",
              "misra"
            ]
          },
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "worst_context_id": {
          "anyOf": [
            {
              "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "incomplete_required_context_ids": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "availability",
        "overall",
        "by_category",
        "worst_context_id",
        "incomplete_required_context_ids",
        "limitations"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "id",
    "source_digest",
    "scorer",
    "consumer_assurance",
    "required_context_ids",
    "optional_context_ids",
    "contexts",
    "aggregate",
    "limitations"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/maintenance_health.schema.json",
  "title": "cppulse measured maintenance health v2"
}
