{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/v2/execution_receipt.schema.json",
  "title": "cppulse execution_receipt v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "producer": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/producer"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "error",
        "timed_out",
        "cancelled",
        "skipped",
        "not_attempted"
      ]
    },
    "reason": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "log_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "tests": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/tests"
    }
  },
  "required": [
    "version",
    "id",
    "source_digest",
    "context_id",
    "producer",
    "argv",
    "cwd",
    "status",
    "reason",
    "exit_code",
    "signal",
    "started_at",
    "finished_at",
    "artifact_ids",
    "log_artifact_ids",
    "depends_on"
  ]
}
