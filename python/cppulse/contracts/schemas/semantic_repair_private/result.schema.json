{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "selected_tests_passed",
        "known_verification_failure",
        "incomplete",
        "canceled"
      ]
    },
    "semantic_equivalence": {
      "const": "not_established"
    },
    "attempt_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "before": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "total",
            "passed",
            "failed",
            "skipped",
            "errors"
          ]
        }
      },
      "required": [
        "run_id",
        "manifest_sha256",
        "source_digest",
        "test_evidence_id",
        "tests"
      ]
    },
    "after": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "store": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "tests": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "passed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "failed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "errors": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "total",
                    "passed",
                    "failed",
                    "skipped",
                    "errors"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "cases": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "run_id",
            "manifest_sha256",
            "source_digest",
            "store",
            "tests",
            "cases"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "actual_agent",
            "human",
            "synthetic_fixture"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "description",
        "evidence_sha256"
      ]
    },
    "adequacy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "required_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "incomplete_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "version",
    "status",
    "semantic_equivalence",
    "attempt_directory",
    "before",
    "after",
    "origin",
    "adequacy",
    "required_cases",
    "request_sha256",
    "patch_sha256",
    "limitations"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/semantic_repair_private/result.schema.json"
}
