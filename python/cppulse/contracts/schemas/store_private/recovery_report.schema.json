{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/store/v1/recovery_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "inspect",
        "recover"
      ]
    },
    "status": {
      "enum": [
        "eligible",
        "protected",
        "no_lock",
        "prepared",
        "recovered",
        "reconcilable",
        "reconciled"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "store": {
      "type": "string"
    },
    "lock_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock_raw_hex": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32768,
      "pattern": "^(?:[a-f0-9]{2})*$"
    },
    "lock": {
      "type": [
        "object",
        "null"
      ]
    },
    "owner_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "absent",
            "alive",
            "pid_reused",
            "zombie",
            "foreign",
            "unknown",
            "legacy",
            "no_lock"
          ]
        },
        "reason": {
          "type": "string"
        },
        "observed": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "start_ticks": {
              "type": "integer",
              "minimum": 1
            },
            "pid_namespace": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "pattern": "^[A-Za-z]$"
            }
          },
          "required": [
            "pid",
            "start_ticks",
            "pid_namespace",
            "uid",
            "state"
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "observed"
      ]
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "mountpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "qualified",
        "type",
        "mountpoint",
        "reason"
      ]
    },
    "reason": {
      "type": "string"
    },
    "preserved_lock": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "preserved_stage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "device": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "const": "left_in_place"
        },
        "content_inventory": {
          "const": "not_computed"
        }
      },
      "required": [
        "path",
        "exists",
        "device",
        "inode",
        "method",
        "content_inventory"
      ]
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts_reused": {
      "const": false
    },
    "observer_pid": {
      "type": "integer",
      "minimum": 1
    },
    "observer_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "boot_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "start_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pid_namespace": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "uid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "boot_id",
        "start_ticks",
        "pid_namespace",
        "uid",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "boot_id": {
                "type": "string"
              },
              "start_ticks": {
                "type": "integer"
              },
              "pid_namespace": {
                "type": "string"
              },
              "uid": {
                "type": "integer"
              },
              "reason": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "boot_id": {
                "type": "null"
              },
              "start_ticks": {
                "type": "null"
              },
              "pid_namespace": {
                "type": "null"
              },
              "uid": {
                "type": "null"
              },
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "current_lock_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "current_lock_action": {
      "enum": [
        "observed_only",
        "removed_selected",
        "left_unchanged"
      ]
    },
    "source_journal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    }
  },
  "required": [
    "version",
    "mode",
    "status",
    "observed_at",
    "store",
    "lock_sha256",
    "lock_raw_hex",
    "lock",
    "owner_observation",
    "filesystem",
    "reason",
    "preserved_lock",
    "preserved_stage",
    "report_path",
    "facts_reused",
    "observer_pid",
    "observer_identity"
  ]
}
