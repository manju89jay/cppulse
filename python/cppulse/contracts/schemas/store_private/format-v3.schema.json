{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phase",
    "plan_sha256"
  ],
  "properties": {
    "version": {
      "const": "3.0.0"
    },
    "phase": {
      "enum": [
        "migrating",
        "active"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
