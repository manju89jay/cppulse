{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "originals",
    "heads"
  ],
  "properties": {
    "version": {
      "const": "3.0.0"
    },
    "heads": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Version 3 atomic store head authority",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "generation",
        "latest",
        "latest_attempt"
      ],
      "properties": {
        "version": {
          "const": "3.0.0"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "manifest_sha256"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "latest_attempt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "manifest_sha256"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "originals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest.json",
        "latest_attempt.json"
      ],
      "properties": {
        "latest.json": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{2}){1,65536}$"
            }
          ]
        },
        "latest_attempt.json": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{2}){1,65536}$"
            }
          ]
        }
      }
    }
  }
}
