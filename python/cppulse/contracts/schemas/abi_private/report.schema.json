{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/abi_private/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "method",
    "request_sha256",
    "tool",
    "source_binding",
    "status",
    "limits",
    "enforced_limits",
    "results",
    "limitations",
    "reader"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "method": {
      "const": "libabigail-2.6-elf-dwarf-v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version",
        "libraries"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": "2.6.0"
        },
        "libraries": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "source_binding": {
      "const": "unverified"
    },
    "status": {
      "enum": [
        "reported",
        "incomplete"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bytes",
        "wall_seconds",
        "log_bytes"
      ],
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "enforced_limits": {
      "const": [
        "input_bytes",
        "wall_seconds",
        "log_bytes"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason",
          "returncode",
          "old",
          "new",
          "log",
          "log_sha256",
          "log_truncated",
          "timed_out",
          "elapsed_seconds",
          "preflight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "no_changes_reported",
              "changes_reported",
              "incompatible_changes_reported",
              "unsupported",
              "unusable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "returncode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "old": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "new": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "log": {
            "type": "string",
            "maxLength": 8388608
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "log_truncated": {
            "type": "boolean"
          },
          "timed_out": {
            "type": "boolean"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "preflight": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "status",
                "returncode",
                "log",
                "log_sha256",
                "log_truncated",
                "timed_out",
                "elapsed_seconds"
              ],
              "properties": {
                "input": {
                  "enum": [
                    "old",
                    "new"
                  ]
                },
                "status": {
                  "enum": [
                    "validated",
                    "unsupported",
                    "unusable"
                  ]
                },
                "returncode": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "log": {
                  "type": "string",
                  "maxLength": 8388608
                },
                "log_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "log_truncated": {
                  "type": "boolean"
                },
                "timed_out": {
                  "type": "boolean"
                },
                "elapsed_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": "2.44"
        }
      }
    }
  }
}
