{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/portfolio/v1/state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schedule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "configuration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "intended_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "enum": [
              "pending",
              "failed",
              "exhausted",
              "succeeded"
            ]
          },
          "next_retry_at": {
            "type": "string",
            "format": "date-time"
          },
          "report_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_status": {
            "enum": [
              "complete",
              "partial",
              null
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "schedule_id",
          "configuration_digest",
          "intended_at",
          "attempts",
          "status",
          "next_retry_at",
          "report_sha256",
          "report_status",
          "error"
        ]
      },
      "maxItems": 4096
    },
    "timezone_bindings": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configuration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "configuration_digest",
          "timezone",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "version",
    "jobs",
    "timezone_bindings"
  ]
}
