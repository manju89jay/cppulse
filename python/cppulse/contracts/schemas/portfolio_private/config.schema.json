{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/portfolio/v1/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "authorized_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 64,
      "minItems": 1,
      "uniqueItems": true
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "store": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "health_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "store",
          "run_id",
          "manifest_sha256"
        ]
      },
      "maxItems": 64,
      "minItems": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "minimum_health": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "scope_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scorer_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required_context_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 64,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "project_id",
          "minimum_health",
          "scope_digest",
          "scorer_digest",
          "required_context_ids"
        ]
      },
      "maxItems": 256
    },
    "team_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "team_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "project_id",
          "team_id",
          "effective_from",
          "effective_until"
        ]
      },
      "maxItems": 512
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "lookback_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "retry_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "timezone",
          "hour",
          "minute",
          "start_date",
          "lookback_days",
          "max_attempts",
          "retry_seconds",
          "enabled"
        ]
      },
      "maxItems": 16
    }
  },
  "required": [
    "version",
    "id",
    "authorized_roots",
    "projects",
    "goals",
    "team_history",
    "schedules"
  ]
}
