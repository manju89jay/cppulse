{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/work-units/v1/query_cursor.schema.json",
  "title": "Draft cppulse query_cursor protocol 1.0; not a supported runtime contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "manifest_sha256": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "query_sha256": {
      "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/sha256"
    },
    "sort": {
      "const": "file-context-rule-location-occurrence-id"
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001f\\u007f]+$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "context_id": {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
        },
        "rule_id": {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "$ref": "https://schemas.cppulse.local/v2/common.schema.json#/definitions/id"
        }
      },
      "required": [
        "file",
        "context_id",
        "rule_id",
        "line",
        "column",
        "occurrence",
        "observation_id"
      ]
    }
  },
  "required": [
    "version",
    "run_id",
    "manifest_sha256",
    "query_sha256",
    "sort",
    "page_size",
    "after"
  ]
}
