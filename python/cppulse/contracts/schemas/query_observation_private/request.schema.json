{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/query-observation/v0.1/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "tracer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "version": {
          "const": "strace -- version 6.13"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "version"
      ]
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096
        },
        "environment": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "argv",
        "cwd",
        "environment"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "max_trace_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 8388608
        },
        "max_stdout_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_line_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        }
      },
      "required": [
        "wall_seconds",
        "max_trace_bytes",
        "max_stdout_bytes",
        "max_events",
        "max_processes",
        "max_line_bytes"
      ]
    },
    "native_report_relative_path": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    }
  },
  "required": [
    "version",
    "source_digest",
    "context_id",
    "native",
    "tracer",
    "invocation",
    "limits",
    "native_report_relative_path"
  ]
}
