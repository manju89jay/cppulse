          }
        },
        "required": [
          "name",
          "file"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "defines": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(=[A-Za-z0-9_]+)?$"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "soname": {
      "type": "string",
      "pattern": "^lib[A-Za-z0-9_]+\\.so\\.[0-9]+$"
    },
    "required_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "container_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "task_label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "fixture_label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "container_id",
        "image_id",
        "host",
        "port",
        "container_port",
        "task_label",
        "fixture_label"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      },
      "required": [
        "step_wall_seconds",
        "log_bytes",
        "input_bytes"
      ]
    }
