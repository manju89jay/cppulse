  "required": [
    "version",
    "profile",
    "compiler",
    "compiler_search_prefix",
    "compiler_library_prefix",
    "compiler_system_include_directories",
    "docker",
    "supervisor_python",
    "before_source",
    "after_source",
    "probe",
    "headers",
    "objects",
    "libraries",
    "defines",
    "soname",
    "required_cases",
    "service",
    "limits"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/service_repair_private/request.schema.json"
}
