{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.cppulse.local/drafts/branch-delivery/v1/capture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repo_path": {
      "type": "string",
      "maxLength": 4096
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "tool": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "maxLength": 256
            },
            "sha256_before": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sha256_after": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stable": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "version",
            "sha256_before",
            "sha256_after",
            "stable"
          ]
        }
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "ref": {
            "type": "string",
            "maxLength": 4096
          },
          "expected_tip": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "observed_tip": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "matched",
              "missing",
              "mismatched",
              "changed",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "ref",
          "expected_tip",
          "observed_tip",
          "status",
          "reason"
        ]
      },
      "maxItems": 16
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "committed_at": {
            "type": "integer",
            "minimum": -62135596800,
            "maximum": 253402300799
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "committed_at",
          "parents"
        ]
      },
      "maxItems": 100000
    },
    "raw_graph": {
      "type": "string",
      "maxLength": 8388608
    },
    "raw_graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "shallow": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "graph_command_complete": {
      "type": "boolean"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "error",
              "timed_out",
              "cancelled"
            ]
          },
          "returncode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "wall_seconds": {
            "type": "number",
            "minimum": 0
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "stderr_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "captured_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          },
          "stderr_tail": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "argv",
          "status",
          "returncode",
          "wall_seconds",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_bytes",
          "stderr_bytes",
          "captured_bytes",
          "truncated",
          "stderr_tail"
        ]
      },
      "maxItems": 64
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 256
    }
  },
  "required": [
    "version",
    "configuration_digest",
    "repo_path",
    "observed_at",
    "tool",
    "refs",
    "nodes",
    "raw_graph",
    "raw_graph_sha256",
    "shallow",
    "truncated",
    "graph_command_complete",
    "commands",
    "limitations"
  ]
}
