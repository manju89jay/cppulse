      "id": "CPP-CX-001",
      "version": "prototype-2",
      "maturity": "experimental",
      "category": "complexity",
      "required_capabilities": [
        "libclang_ast"
      ],
      "supported_inputs": [
        "c++_translation_unit",
        "c++_header_with_context"
      ],
      "configuration_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Cyclomatic complexity",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "warning_threshold": {
            "type": "integer",
            "minimum": 0,
            "default": 15,
            "maximum": 2147483647
          },
          "error_threshold": {
            "type": "integer",
            "minimum": 0,
            "default": 25,
            "maximum": 2147483647
          }
        },
        "x-cppulse-native": {
          "class": "CyclomaticComplexityRule",
          "header": "rules/complexity/cyclomatic_complexity.h",
          "order": 12
        }
      },
      "documentation": "Detect functions with high cyclomatic complexity. Availability depends on a successfully parsed selected context; findings are experimental signals, not compliance evidence. Detector semantics revised on 2026-11-14 with explicit written-type and function/template scope regressions; experimental maturity is unchanged."
    },
