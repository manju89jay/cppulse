# Explicit local snapshot checks. This module never starts collection or a
# recursive build. DEPENDS orders targets; verification scope comes from the
# selected snapshot/policy or finding request, not target names.
include_guard(GLOBAL)

function(cppulse_add_check)
  cmake_parse_arguments(PARSE_ARGV 0 CPPULSE
    "ENFORCE_DEFAULT_BUILD;EXPORT_COMPILE_COMMANDS"
    "NAME;EXECUTABLE;STORE;WORKSPACE;POLICY;FINDINGS;RUN_ID;MANIFEST_SHA256;CONTEXT_DATABASE_OUT_VAR"
    "DEPENDS")
  if(CPPULSE_UNPARSED_ARGUMENTS OR CPPULSE_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "cppulse_add_check received unknown options or missing values")
  endif()
  foreach(required NAME STORE WORKSPACE)
    if(NOT DEFINED CPPULSE_${required} OR "${CPPULSE_${required}}" STREQUAL "")
      message(FATAL_ERROR "cppulse_add_check requires ${required}")
    endif()
  endforeach()
  if(NOT CPPULSE_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_.+-]*$" OR TARGET "${CPPULSE_NAME}")
    message(FATAL_ERROR "cppulse check NAME must be a new ordinary target name")
  endif()
  if((NOT CPPULSE_POLICY AND NOT CPPULSE_FINDINGS) OR (CPPULSE_POLICY AND CPPULSE_FINDINGS))
    message(FATAL_ERROR "Select exactly one POLICY file or FINDINGS request")
  endif()
  if((CPPULSE_RUN_ID AND NOT CPPULSE_MANIFEST_SHA256) OR (CPPULSE_MANIFEST_SHA256 AND NOT CPPULSE_RUN_ID))
    message(FATAL_ERROR "Select both RUN_ID and MANIFEST_SHA256, or neither")
  endif()
  if(CPPULSE_RUN_ID)
    string(LENGTH "${CPPULSE_RUN_ID}" run_length)
    string(LENGTH "${CPPULSE_MANIFEST_SHA256}" hash_length)
    if(run_length GREATER 64 OR NOT CPPULSE_RUN_ID MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$"
       OR NOT hash_length EQUAL 64 OR NOT CPPULSE_MANIFEST_SHA256 MATCHES "^[a-f0-9]+$")
      message(FATAL_ERROR "Invalid cppulse run/manifest pin")
    endif()
  endif()

  foreach(path STORE WORKSPACE POLICY FINDINGS)
    if(DEFINED CPPULSE_${path})
      get_filename_component(CPPULSE_${path} "${CPPULSE_${path}}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
  endforeach()
  if(NOT IS_DIRECTORY "${CPPULSE_WORKSPACE}")
    message(FATAL_ERROR "cppulse WORKSPACE must be an existing directory")
  endif()
  if(CPPULSE_EXECUTABLE)
    if(IS_ABSOLUTE "${CPPULSE_EXECUTABLE}" OR CPPULSE_EXECUTABLE MATCHES "[/\\\\]")
      get_filename_component(cppulse_program "${CPPULSE_EXECUTABLE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    else()
      find_program(cppulse_program NAMES "${CPPULSE_EXECUTABLE}" REQUIRED NO_CACHE)
    endif()
  else()
    find_program(cppulse_program NAMES cppulse REQUIRED NO_CACHE)
  endif()
  if(NOT EXISTS "${cppulse_program}" OR IS_DIRECTORY "${cppulse_program}")
    message(FATAL_ERROR "cppulse executable is unavailable; activate its environment or set EXECUTABLE")
  endif()
  foreach(dependency IN LISTS CPPULSE_DEPENDS)
    if(NOT TARGET "${dependency}")
      message(FATAL_ERROR "Unknown selected cppulse dependency target: ${dependency}")
    endif()
  endforeach()

  if(CPPULSE_EXPORT_COMPILE_COMMANDS)
    if(NOT CMAKE_GENERATOR MATCHES "Makefiles|Ninja")
      message(FATAL_ERROR "Compile database export requires a Makefiles or Ninja generator")
    endif()
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON PARENT_SCOPE)
    foreach(dependency IN LISTS CPPULSE_DEPENDS)
      get_target_property(dependency_type "${dependency}" TYPE)
      if(dependency_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
        set_property(TARGET "${dependency}" PROPERTY EXPORT_COMPILE_COMMANDS ON)
      endif()
    endforeach()
  endif()
  if(CPPULSE_CONTEXT_DATABASE_OUT_VAR)
    if(NOT CMAKE_EXPORT_COMPILE_COMMANDS)
      message(FATAL_ERROR "Enable EXPORT_COMPILE_COMMANDS to discover a compilation database")
    endif()
    set("${CPPULSE_CONTEXT_DATABASE_OUT_VAR}" "${CMAKE_BINARY_DIR}/compile_commands.json" PARENT_SCOPE)
  endif()

  set(check_command "${cppulse_program}" check --store "${CPPULSE_STORE}" --workspace "${CPPULSE_WORKSPACE}")
  if(CPPULSE_POLICY)
    list(APPEND check_command --policy "${CPPULSE_POLICY}")
  else()
    list(APPEND check_command --findings "${CPPULSE_FINDINGS}")
  endif()
  if(CPPULSE_RUN_ID)
    list(APPEND check_command --run-id "${CPPULSE_RUN_ID}" --manifest-sha256 "${CPPULSE_MANIFEST_SHA256}")
  endif()
  if(CPPULSE_ENFORCE_DEFAULT_BUILD)
    add_custom_target("${CPPULSE_NAME}" ALL
      COMMAND ${check_command} WORKING_DIRECTORY "${CPPULSE_WORKSPACE}" VERBATIM)
  else()
    add_custom_target("${CPPULSE_NAME}"
      COMMAND ${check_command} WORKING_DIRECTORY "${CPPULSE_WORKSPACE}" VERBATIM)
  endif()
  if(CPPULSE_DEPENDS)
    add_dependencies("${CPPULSE_NAME}" ${CPPULSE_DEPENDS})
  endif()
endfunction()
