# Exercise actual CLI behavior rather than only constructor plumbing.
set(root "${CMAKE_CURRENT_BINARY_DIR}/resource-dir-${MODE}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/project" "${root}/resource/include")
file(WRITE "${root}/project/source.cpp"
    "#include <stddef.h>\n#ifndef CPPULSE_TEST_RESOURCE\n#error resource override not used\n#endif\ntypedef int Counter;\nvoid valid() {}\n")
file(WRITE "${root}/resource/include/stddef.h" "#define CPPULSE_TEST_RESOURCE 1\n")
set(arguments --repo "${root}/project" --output "${root}/output")
if(MODE STREQUAL "relative_repo")
    set(arguments --repo project --output "${root}/output")
endif()
if(MODE STREQUAL "valid_db" OR MODE STREQUAL "valid_inferred" OR MODE STREQUAL "valid_barrier")
    file(WRITE "${root}/project/compile_commands.json"
        "[{\"directory\":\"${root}/project\",\"file\":\"source.cpp\",\"arguments\":[\"clang++\",\"-std=c++17\",\"-c\",\"source.cpp\"]}]")
endif()
if(MODE STREQUAL "valid_inferred")
    file(WRITE "${root}/project/detail.hpp"
        "#include <stddef.h>\n#ifndef CPPULSE_TEST_RESOURCE\n#error inferred resource missing\n#endif\ntypedef int HeaderCount;\n")
elseif(MODE STREQUAL "valid_barrier")
    file(WRITE "${root}/project/compile_commands.json"
        "[{\"directory\":\"${root}/project\",\"file\":\"source.cpp\",\"arguments\":[\"clang++\",\"-std=c++17\",\"-c\",\"--\",\"source.cpp\"]}]")
endif()
if(MODE STREQUAL "invalid_env")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "CPPULSE_CLANG_RESOURCE_DIR=${root}/missing"
        "${ANALYZER_BIN}" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
elseif(MODE STREQUAL "invalid_flag")
    execute_process(COMMAND "${ANALYZER_BIN}" ${arguments} --resource-dir "${root}/missing"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
else()
    execute_process(COMMAND "${ANALYZER_BIN}" ${arguments} --resource-dir "${root}/resource"
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
endif()
if(MODE MATCHES "^invalid")
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Invalid override must exit 2; got ${result}: ${output}${error}")
    endif()
    string(FIND "${output}${error}" "Invalid libclang resource directory" diagnostic)
    if(diagnostic EQUAL -1)
        message(FATAL_ERROR "Expected resource validation diagnostic: ${output}${error}")
    endif()
elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "Valid resource override failed (${result}): ${output}${error}")
else()
    file(READ "${root}/output/findings.json" document)
    string(REGEX MATCH "\"status\"[ \n\r\t]*:[ \n\r\t]*\"([^\"]*)\"" match "${document}")
    set(status "${CMAKE_MATCH_1}")
    string(REGEX MATCH "\"compile_context\"[ \n\r\t]*:[ \n\r\t]*\"([^\"]*)\"" match "${document}")
    set(context "${CMAKE_MATCH_1}")
    string(REGEX MATCH "\"error_count\"[ \n\r\t]*:[ \n\r\t]*([0-9]+)" match "${document}")
    set(errors "${CMAKE_MATCH_1}")
    if(NOT status STREQUAL "analyzed" OR NOT errors EQUAL 0)
        message(FATAL_ERROR "Resource header was not used: ${document}\n${output}${error}")
    endif()
    if(MODE STREQUAL "relative_repo")
        string(REGEX MATCH "\"repo_path\"[ \n\r\t]*:[ \n\r\t]*\"([^\"]*)\"" match "${document}")
        set(recorded_repo "${CMAKE_MATCH_1}")
        get_filename_component(expected_repo "${root}/project" REALPATH)
        file(TO_CMAKE_PATH "${expected_repo}" expected_repo)
        if(NOT recorded_repo STREQUAL expected_repo)
            message(FATAL_ERROR "Repository metadata must be canonical absolute: ${recorded_repo}; expected ${expected_repo}")
        endif()
        string(REGEX MATCH "\"path\"[ \n\r\t]*:[ \n\r\t]*\"([^\"]*)\"" match "${document}")
        if(NOT CMAKE_MATCH_1 STREQUAL "${expected_repo}/source.cpp")
            message(FATAL_ERROR "Coverage path must join the repository identity: ${CMAKE_MATCH_1}")
        endif()
        string(REGEX MATCH "\"file\"[ \n\r\t]*:[ \n\r\t]*\"([^\"]*)\"" match "${document}")
        if(NOT CMAKE_MATCH_1 STREQUAL "source.cpp")
            message(FATAL_ERROR "Finding path must be repository-relative: ${CMAKE_MATCH_1}")
        endif()
    endif()
    if(MODE STREQUAL "valid_inferred" AND NOT context STREQUAL "inferred")
        message(FATAL_ERROR "Header context must remain inferred: ${context}")
    endif()
    if((MODE STREQUAL "valid_db" OR MODE STREQUAL "valid_barrier") AND
       NOT context STREQUAL "database")
        message(FATAL_ERROR "Resource override must preserve database context: ${context}")
    elseif(MODE STREQUAL "valid_fallback" AND NOT context STREQUAL "fallback")
        message(FATAL_ERROR "Resource override must preserve fallback context: ${context}")
    endif()
endif()
file(REMOVE_RECURSE "${root}")
