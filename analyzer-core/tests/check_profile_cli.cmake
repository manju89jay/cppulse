# A profile override changes validated inputs before analysis, never its output.
if(NOT DEFINED ANALYZER_BIN)
    message(FATAL_ERROR "ANALYZER_BIN required")
endif()
set(_root "${CMAKE_CURRENT_BINARY_DIR}/profile_cli")
if(EXISTS "${_root}")
    message(FATAL_ERROR "Owned profile fixture already exists: ${_root}")
endif()
file(MAKE_DIRECTORY "${_root}/source")
file(WRITE "${_root}/source/case.cpp" "int f() { goto finish; finish: return 1; }\n")
file(WRITE "${_root}/config.json" "{\"profile\":\"default\"}\n")
foreach(_profile default safety-critical)
    execute_process(COMMAND "${ANALYZER_BIN}" --repo "${_root}/source"
        --config "${_root}/config.json" --profile "${_profile}"
        --output "${_root}/${_profile}"
        RESULT_VARIABLE _exit ERROR_VARIABLE _err)
    if(NOT _exit EQUAL 0)
        message(FATAL_ERROR "Profile invocation failed ${_exit}: ${_err}")
    endif()
    file(READ "${_root}/${_profile}/findings.json" _report)
    string(JSON _count LENGTH "${_report}" findings)
    set(_goto 0)
    if(_count GREATER 0)
        math(EXPR _last "${_count}-1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _id GET "${_report}" findings ${_index} rule_id)
            if(_id STREQUAL "MISRA-001")
                math(EXPR _goto "${_goto}+1")
            endif()
        endforeach()
    endif()
    if(NOT _goto EQUAL 1)
        message(FATAL_ERROR "Scoring profile silently filtered an independently enabled detector")
    endif()
    if(NOT _err MATCHES "does not filter detectors")
        message(FATAL_ERROR "Legacy native profile limitation must be explicit")
    endif()
endforeach()
file(WRITE "${_root}/disabled.json"
    "{\"rules\":{\"MISRA-001\":{\"enabled\":false}}}\n")
execute_process(COMMAND "${ANALYZER_BIN}" --repo "${_root}/source"
    --config "${_root}/disabled.json" --profile safety-critical
    --output "${_root}/disabled-output" RESULT_VARIABLE _disabled ERROR_VARIABLE _err)
if(NOT _disabled EQUAL 0)
    message(FATAL_ERROR "Explicit detector selection failed: ${_err}")
endif()
file(READ "${_root}/disabled-output/findings.json" _disabled_report)
string(JSON _disabled_findings GET "${_disabled_report}" findings)
if(_disabled_findings MATCHES "MISRA-001")
    message(FATAL_ERROR "Scoring profile must not re-enable explicitly disabled detector")
endif()
file(WRITE "${_root}/invalid.json" "{\"profile\":\"unknown\"}\n")
execute_process(COMMAND "${ANALYZER_BIN}" --repo "${_root}/source"
    --config "${_root}/invalid.json" --profile default --output "${_root}/invalid-output"
    RESULT_VARIABLE _invalid ERROR_VARIABLE _err)
if(NOT _invalid EQUAL 2 OR EXISTS "${_root}/invalid-output/findings.json")
    message(FATAL_ERROR "Profile override bypassed invalid explicit config")
endif()
execute_process(COMMAND "${ANALYZER_BIN}" --repo "${_root}/source"
    --profile unknown --output "${_root}/unknown-output" RESULT_VARIABLE _unknown)
if(_unknown EQUAL 0 OR EXISTS "${_root}/unknown-output/findings.json")
    message(FATAL_ERROR "Unknown profile must fail before publication")
endif()
file(REMOVE_RECURSE "${_root}")
