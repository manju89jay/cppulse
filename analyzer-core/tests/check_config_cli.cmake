# Native entry-point regression cases: invalid configuration is an invocation
# error, while an explicit selection resolves otherwise ambiguous discovery.
if(NOT DEFINED ANALYZER_BIN OR NOT DEFINED MODE)
    message(FATAL_ERROR "ANALYZER_BIN and MODE are required")
endif()
set(_work "${CMAKE_CURRENT_BINARY_DIR}/config_cli_${MODE}")
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}/repo")
file(WRITE "${_work}/repo/clean.cpp" "int clean() { return 0; }\n")
set(_extra)
set(_expected 2)
if(MODE STREQUAL "unknown_key")
    file(WRITE "${_work}/repo/.cppulserc.json" "{\"profiel\":\"default\"}")
elseif(MODE STREQUAL "wrong_type")
    file(WRITE "${_work}/repo/.cppulserc.json" "{\"rules\":{\"CPP-MEM-001\":{\"enabled\":\"false\"}}}")
elseif(MODE STREQUAL "ambiguous" OR MODE STREQUAL "explicit")
    file(WRITE "${_work}/repo/.cppulserc.json" "{\"profile\":\"default\"}")
    file(WRITE "${_work}/repo/.cppulserc.yml" "profile: safety-critical\n")
    if(MODE STREQUAL "explicit")
        set(_expected 0)
        list(APPEND _extra --config "${_work}/repo/.cppulserc.json")
    endif()
else()
    message(FATAL_ERROR "Unknown MODE ${MODE}")
endif()
execute_process(
    COMMAND "${ANALYZER_BIN}" --repo "${_work}/repo" --output "${_work}/output" ${_extra}
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _stdout
    ERROR_VARIABLE _stderr
)
if(NOT _result STREQUAL "${_expected}")
    message(FATAL_ERROR "Expected exit ${_expected}, got ${_result}: ${_stderr}${_stdout}")
endif()
if(_expected EQUAL 2)
    if(_stderr STREQUAL "" OR NOT _stdout STREQUAL "")
        message(FATAL_ERROR "Configuration errors must be logged on stderr: ${_stdout}${_stderr}")
    endif()
    if(EXISTS "${_work}/output/findings.json")
        message(FATAL_ERROR "Invalid configuration must not publish a findings document")
    endif()
else()
    if(NOT EXISTS "${_work}/output/findings.json")
        message(FATAL_ERROR "Explicit configuration did not produce findings")
    endif()
endif()
file(REMOVE_RECURSE "${_work}")
